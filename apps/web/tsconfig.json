{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@mcsr/shared": ["../../packages/shared/src/index.ts"],
      "@mcsr/shared/seed": ["../../packages/shared/src/seed.ts"],
      "@mcsr/shared/i18n": ["../../packages/shared/src/i18n/index.ts"],
      "@mcsr/shared/resources": ["../../packages/shared/src/resources.ts"],
      "@mcsr/ui": ["../../packages/ui/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
