# ---------------------------------------------------------------------------
# Ranked Seeds 上游地址 —— **只存在于服务器上，不进版本库**
#
# 安装（在服务器上执行一次）：
#
#   sudo install -d -m 0755 /etc/mcsr-helper
#   sudo install -m 0600 -o root -g root /dev/null /etc/mcsr-helper/seeds.env
#   sudo nano /etc/mcsr-helper/seeds.env      # 填入下面那行（把地址换成你的上游）
#   sudo systemctl daemon-reload && sudo systemctl restart mcsr-helper-api
#
# 这一份**不是密钥**，为什么还要单独一个文件？因为它是**部署相关的配置**，
# 而 deploy.sh 每次部署都会用版本库里的 mcsr-helper-api.service 覆盖服务器上
# 那个单元文件（`cmp` 之后 `install`）—— 把一个地址写进单元里，下一次部署
# 就会被**静默抹掉**，症状是"部署之后种子功能突然全 503"，而 deploy.sh 报成功。
# 这个文件 deploy.sh 不碰（它只装 .example 模板），所以它能活过部署。
# （同一条纪律的先例：mail.env / track.env —— 那两个是密钥，这一个只是地址。）
#
# ---------------------------------------------------------------------------
# ⚠️ 不填会怎样：整组种子接口返回 503 seed_not_configured
# ---------------------------------------------------------------------------
# 上游地址**没有代码内的默认值**，这是有意的：上游是**第三方**的机器，
# 而 `POST /api/ranked-seeds/save` 会往那台机器的数据库里**插记录**。
# 一个写死的默认值等于让每个照抄本仓的人都在对别人的服务做写操作，
# 所以现在"不配 = 这条功能不可用"，而不是"不配就用某个陌生人的地址"。
#
# 不填时界面（/seeds）说的是「本站没有配置种子数据源 —— 这不是临时故障，
# 重复尝试也不会有变化」，后端日志里（只打一次）会指到这个文件。
#
# ---------------------------------------------------------------------------
# ⚠️ 写入默认是关的，要开必须显式打开
# ---------------------------------------------------------------------------
# 补录（POST /api/ranked-seeds/save）会往**上游那台机器的数据库**里写记录，
# 所以它默认关闭：只有 `MCSR_SEED_WRITE_ENABLED=1` 才允许写入。
# 这是自建者最需要的一道保险 —— 别人的库里不该出现你没打算写的记录。
#
# 紧急关闭的做法：把那一行删掉（或改成 0），然后
#   sudo systemctl daemon-reload && sudo systemctl restart mcsr-helper-api
# 代码每个请求都读 process.env，所以不需要重新打包、上传产物或重新部署；
# 但 **restart 是必须的** —— EnvironmentFile 只在进程启动时读。
# ---------------------------------------------------------------------------

# 上游 Base URL，**结尾不要带斜杠**（代码会去掉一个，但别依赖它）。
# ⚠️ 用**你自己**的上游。不要填别人的地址 —— 尤其是别把从别处抄来的、
#    属于某个人的地址填进来：查询会用掉对方的机器，写入会往对方的库里插数据。
MCSR_SEED_API_BASE=

# 写入开关。默认关闭；确认你要往**上面那个地址**写记录时再去掉注释。
# ⚠️ 打开之后，任何"登录 + 邮箱已验证"的用户都能通过本站往那个库里补录，
#    而对面那台机器的主人不会收到通知 —— 打开之前先确认你是在自己的上游上写。
# MCSR_SEED_WRITE_ENABLED=1

# 上游请求超时（毫秒）。有代码内默认值 15000，一般不用写。
# 上游是小机器，带筛选的随机查询实测 3–4 秒，改小会把**成功**的查询报成失败。
# MCSR_SEED_TIMEOUT_MS=15000
