# /etc/systemd/system/mcsr-helper-api.service
#
# 安装：
#   sudo cp deploy/mcsr-helper-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mcsr-helper-api
#
# 注意 HOST 固定为 127.0.0.1：API 绝不能被公网直连，
# 对外只能经由 Caddy 的 HTTPS。

[Unit]
Description=MCSR Helper API
# 仓库地址（改名的话这里与六份 package.json 要一起改）
#    （与 package.json 的 repository/homepage/bugs 三处保持一致，清单见 README 末尾
#     的「发布前要改的占位符」）。
Documentation=https://github.com/Andy-ac/mcsr-helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcsr
Group=mcsr
WorkingDirectory=/srv/mcsr-helper/api

Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
# DB_PATH 显式给出，不依赖 cwd。否则"从别的目录启动服务"会静默打开另一个库文件 ——
# 表现为"数据不见了"，而且要查很久才会想到是路径问题。
Environment=DB_PATH=/srv/mcsr-helper/api/data/mcsr.db
# 上传的图片落在同一个 data 目录里（它已经存在、且 mcsr 用户可写）。
# ⚠️ 显式写出来而不是靠 "./data/uploads" 的默认值：那个默认值是相对于
#    WorkingDirectory 的，一旦有人改了 WorkingDirectory 或 DB_PATH，
#    图片会**静默地**换地方 —— 表现是"老图全 404，新图能看"。
Environment=UPLOAD_DIR=/srv/mcsr-helper/api/data/uploads
# node:sqlite 目前会打印一行 ExperimentalWarning。功能正常，只是噪音；
# 关掉它以免掩盖真正的警告。
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning

# ---- 邮件（M2）----
#
# 发信走 mail.mcsrhelper.com 子域，SPF/DKIM/DMARC 都配在它上面 ——
# 这样邮件声誉和站点声誉解耦：万一发信域被判垃圾，站点不受影响。
# DNS 记录由 Resend 指定，配置过程见 docs/v1-plan.md §9.2。
#
# ⚠️ 域名必须和 packages/shared/src/constants.ts 的 SITE.mailSubdomain 一致。
Environment=MCSR_PUBLIC_ORIGIN=https://mcsrhelper.com
Environment=MCSR_MAIL_DRIVER=resend
Environment=MCSR_MAIL_FROM=noreply@mail.mcsrhelper.com
# ⚠️⚠️ 值里有空格 ⇒ **双引号是必须的，不是风格问题**。
#     systemd 把 Environment= 的整行按空白切成若干个赋值，所以不加引号的
#     `Environment=MCSR_MAIL_FROM_NAME=MCSR Helper` 会被切成两段：
#       · MCSR_MAIL_FROM_NAME=MCSR   —— 生效（发件人名字被**静默截断**成 MCSR）
#       · Helper                     —— 没有等号，systemd 丢掉它，并在**每一次
#                                       daemon-reload / restart** 往 journal 里写
#                                       "Invalid environment assignment, ignoring: Helper"
#     代价：生产上的发件人名字一直显示「MCSR」而不是「MCSR Helper」，
#     而部署自检一个字都不会说（它只查 systemctl is-active 与本机 /api/health）。
#     ⇒ 部署后必须回读一次：journalctl -u mcsr-helper-api | grep 'Invalid environment'
#       必须是**空**的；再发一封真邮件确认收件人看到的是完整名字。
Environment="MCSR_MAIL_FROM_NAME=MCSR Helper"

# ⚠️⚠️ 密钥**不在这里**，它在服务器上的独立文件：
#         /etc/mcsr-helper/mail.env     （chmod 600，root 所有）
#
# 为什么不写在本单元里：本单元在版本库里，而 deploy.sh 每次部署都会把它同步到
# 服务器。把 RESEND_API_KEY 写进来 = 把发信权限提交到 git 历史里，
# 而且**删掉也还在历史里**。密钥只应该存在于它被使用的那台机器上。
#
# 文件格式见 deploy/mail.env.example。首次部署时手工创建一次。
# 前缀的 `-` 表示"文件不存在也照常启动" —— 本地和其它环境没有这个文件。
EnvironmentFile=-/etc/mcsr-helper/mail.env

# ---- 视频追踪的凭据（M4 第九轮）----
#
# ★★ 为什么 **API** 也要读这一份（2026-09-16 上线后补的，原来漏了它）：
#   "加一个博主"这条路**走的是 API 进程** —— 管理面板的 POST /api/tracking/creators
#   会在这一步调适配器的 `resolveCreator`（去上游解析 handle / login 拿名字与头像），
#   而注册表 `adapterFor()` 是**按环境变量**判断"这个平台配没配"的。
#   ⇒ 只把凭据给 `mcsr-helper-track.service`（同步那一侧）的话，
#     **面板上加不了 YouTube / Twitch 的博主**：会得到 503 `platform_not_configured`
#     （`routes/tracking.ts` 那张分类表的 NoCredentialsError 一格），
#     而每一轮的同步摘要里那两个平台**又不会被跳过**（同步进程看得到变量）——
#     两边的状态不一致，看起来像"配好了但加不上"。
#
# ⚠️ 与 mail.env 是同一条纪律：密钥不写进本单元（它在版本库里，deploy.sh 每次同步），
#    只存在于服务器上那个 0600 root 的文件里。格式见 `deploy/track.env.example`。
# ⚠️ `-` 前缀：文件不存在也照常启动 —— **今天生产上就是不存在**（`track.env.example`
#    随部署装到 /etc/mcsr-helper/，但真正的 track.env 要人去建），
#    而一个都不配是完全正常的状态（bilibili 不需要凭据）。
# ⚠️ 改这个文件之后**必须 restart**（和 mail.env 一样）：`EnvironmentFile` 是进程启动时
#    读的，而 API 是长驻进程 ⇒ `systemctl restart mcsr-helper-api`。
#    同步那侧不用重启（`Type=oneshot`，每 10 分钟一个新进程）。
EnvironmentFile=-/etc/mcsr-helper/track.env

# ---- Ranked Seeds 上游代理（M4）----
#
# 三个变量，其中**两个必须显式给**（2026-09-19 开源前改的口径）：
#   MCSR_SEED_API_BASE        上游地址 —— **没有默认值**，不配 = 这条功能不可用
#   MCSR_SEED_TIMEOUT_MS      默认 15000（有默认值，一般不用管）
#   MCSR_SEED_WRITE_ENABLED   默认关闭 —— 不设 = 补录（写接口）被拒
#
# ⚠️⚠️ `MCSR_SEED_API_BASE` 原来有一个写死的默认值（owner 自己的另一台机器）。
#     公开之后那不能留：上游是**第三方**的机器，而写接口（POST /ranked-seeds/save）
#     会往那台机器的数据库里**插记录** —— 一个默认值等于让每个照抄本仓的人
#     都在对别人的服务做写操作。所以现在不配就整组端点回
#     503 `seed_not_configured`（前端会说"本站没有配置种子数据源"，
#     而不是一个让人白等的"上游暂时不可用"）。
#
# ⚠️⚠️ **部署这一步必须与代码同步做**（否则升级完这个功能就没了）：
#     生产现在**正在依赖**那个旧默认值。改动上线时必须在服务器上把地址显式补上，
#     位置是下面那个 EnvironmentFile 指向的文件：
#
#         /etc/mcsr-helper/seeds.env      （0600 root，只在这台机器上）
#
#     内容一行就够：`MCSR_SEED_API_BASE=<上游地址>`（写入要开再加一行
#     `MCSR_SEED_WRITE_ENABLED=1`）。模板见 deploy/seeds.env.example。
#
#     ⚠️ **不要**改 /etc/systemd/system/mcsr-helper-api.service 本身来加它：
#        deploy.sh 每次部署都会用版本库里的单元文件覆盖那个路径（`cmp` 之后
#        install），手改的值会在下一次部署里被**静默抹掉** —— 症状是"部署之后
#        种子功能突然全 503"，而 deploy.sh 报的是成功。
#        EnvironmentFile 指向的文件 deploy.sh **不碰**（它只装 .example 模板），
#        所以那是唯一能活过部署的位置。
#
#     ⚠️ 改完必须 `systemctl daemon-reload && systemctl restart mcsr-helper-api`：
#        EnvironmentFile 与 Environment= 都是**进程启动时**读的，reload 看不到。
#        与 mail.env / track.env 的纪律完全一样。
#
# ⚠️ 上游只有明文 HTTP 一个入口，这正是我们做后端代理的原因：浏览器在 https
#    页面上不允许请求 http 资源（混合内容），而种子查询必须能在线上工作。
#    代理不是"顺手加的一层"，它是这条功能成立的前提。
#    所以**不要**让前端直连上游，也不要把上游地址下发给客户端。
#
# ⚠️ 写接口的开关现在是**正向**的（`MCSR_SEED_WRITE_ENABLED`，默认关）。
#    出事时（被刷、被扫、上游改了 schema 而我们还没跟上）的正确动作是：
#    把那一行删掉（或改成 0），然后 daemon-reload + restart，写入路径立刻停掉。
#    代码每次请求都读 process.env，所以不需要重新打包和上传产物。
#
# Environment=MCSR_SEED_WRITE_ENABLED=1
EnvironmentFile=-/etc/mcsr-helper/seeds.env

ExecStart=/usr/bin/node /srv/mcsr-helper/api/server.js
Restart=always
RestartSec=3

# ---- 加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mcsr-helper/api/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

# 日志进 journald：journalctl -u mcsr-helper-api -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcsr-helper-api

[Install]
WantedBy=multi-user.target
