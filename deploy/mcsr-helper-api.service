# /etc/systemd/system/mcsr-helper-api.service
#
# 安装：
#   sudo cp deploy/mcsr-helper-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mcsr-helper-api
#
# 注意 HOST 固定为 127.0.0.1：API 绝不能被公网直连，
# 对外只能经由 Caddy 的 HTTPS。

[Unit]
Description=MCSR Helper API
Documentation=https://github.com/your-org/mcsr-helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcsr
Group=mcsr
WorkingDirectory=/srv/mcsr-helper/api

Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
# DB_PATH 显式给出，不依赖 cwd。否则"从别的目录启动服务"会静默打开另一个库文件 ——
# 表现为"数据不见了"，而且要查很久才会想到是路径问题。
Environment=DB_PATH=/srv/mcsr-helper/api/data/mcsr.db
# node:sqlite 目前会打印一行 ExperimentalWarning。功能正常，只是噪音；
# 关掉它以免掩盖真正的警告。
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning

# ---- 邮件（M2）----
#
# ⚠️ 发信域名**不能**是 cloud-ip.cc —— 它在 Spamhaus DBL 上被列名为
#    phishing (127.0.0.1.4) + botnet C&C (127.0.0.1.6)。详见 docs/v1-plan.md §9.2。
#    测投递率必须换一个干净域名；换域名只需要改下面这几行，代码不用动。
#
# 下面三行是**故意注释掉**的：没配置时驱动是 console，验证邮件只会打进日志，
# 而进程启动时会打印一条 ⚠️ 警告。这样"忘了配"是一个可见的状态，
# 而不是"用户说他没收到邮件"。
#
# Environment=MCSR_MAIL_DRIVER=resend
# Environment=MCSR_MAIL_FROM=noreply@mail.<你的干净域名>
# Environment=MCSR_MAIL_FROM_NAME=MCSR Helper
# Environment=RESEND_API_KEY=re_xxxxxxxx
#
# 邮件里的链接指向哪里。不设时用 shared/constants.ts 里的 productionOrigin。
Environment=MCSR_PUBLIC_ORIGIN=https://legacy.example.invalid

ExecStart=/usr/bin/node /srv/mcsr-helper/api/server.js
Restart=always
RestartSec=3

# ---- 加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mcsr-helper/api/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

# 日志进 journald：journalctl -u mcsr-helper-api -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcsr-helper-api

[Install]
WantedBy=multi-user.target
