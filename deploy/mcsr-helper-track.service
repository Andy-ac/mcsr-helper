# deploy/mcsr-helper-track.service
#
# 安装（deploy.sh 会做，手工装的话是这几行）：
#   sudo install -m 0644 deploy/mcsr-helper-track.service /etc/systemd/system/
#   sudo install -m 0644 deploy/mcsr-helper-track.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mcsr-helper-track.timer
#
# ⚠️ 两个文件名**不能改**：timer 里没有写 `Unit=`，systemd 就是按**同名**去找
#    这个 service（`mcsr-helper-track.timer` → `mcsr-helper-track.service`）。
#    改名的表现是"timer 装上了、时间到了什么都没发生"。
#
# ⚠️ 这里**故意没有**加固那一套（api 单元里的 ProtectSystem / ReadWritePaths…）——
#    那是一次独立的安全改动，不在这一轮里。要加的时候先看清下面 RuntimeDirectory
#    那一段：锁文件必须落在一个**本单元可写**的目录里，而 /run 本身不是。

[Unit]
Description=MCSR Helper — tracked video sync (one shot)
After=network-online.target

[Service]
Type=oneshot
User=mcsr
# ★ 与 mcsr-helper-api.service:20 逐字对齐（2026-09-16 最终评审补的一行）：那个单元
#   已经在生产上用 Group=mcsr 跑着 ⇒ 这个组一定存在。写了它的作用是**明确**，
#   而不是靠"systemd 会去取这个用户的主组"那条默认行为 —— 默认值在有人把 mcsr
#   加进别的组、或换了机器重建用户时会变，而变了以后 RuntimeDirectory 的属组
#   跟着变，表现是那个锁目录的权限与 api 单元建出来的不是一套。
Group=mcsr
WorkingDirectory=/srv/mcsr-helper/api
Environment=NODE_ENV=production
# DB_PATH 显式给出，不依赖 cwd —— 与 mcsr-helper-api.service 同一条理由：
# 否则"从别的目录启动"会静默打开另一个库文件，表现为"数据不见了"。
Environment=DB_PATH=/srv/mcsr-helper/api/data/mcsr.db
# node:sqlite 目前会打印一行 ExperimentalWarning。功能正常，只是噪音；
# 关掉它以免掩盖真正的警告。
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning
# ---- 凭据 ----
#
# ⚠️ 密钥**不在这里**，它在服务器上的独立文件 /etc/mcsr-helper/track.env
#    （chmod 600，root 所有）。理由与 mail.env 完全一样（见 deploy/mail.env.example）：
#    本单元在版本库里，而 deploy.sh 每次部署都会把它同步到服务器 ——
#    把 MCSR_YOUTUBE_KEY 写进来 = 把配额提交进 git 历史，删掉也还在历史里。
#
# ⚠️ 前缀的 `-` 表示"文件不存在也照常启动"。这不是可有可无的：
#    bilibili **不需要任何凭据**（spec §2.7），生产上今天就是一个 key 都没有
#    ⇒ 这个文件通常还不存在，而那**不是**错误（youtube/twitch 会被跳过并打印原因）。
EnvironmentFile=-/etc/mcsr-helper/track.env
# ---- 防重叠（★ spec §3.4 要求，不是顺手加的）----
#
# `Type=oneshot` 的 timer **不保证**上一轮跑完才启动下一轮：到点了 systemd 就会起。
# 而 db/index.ts 里 `PRAGMA busy_timeout = 5000` 会让两个重叠的进程**排队等着写**
# 而不是报错 ⇒ 同一页会被处理两遍、同一个游标会被两个进程各自推进、水位互相覆盖，
# 而且日志里一行错都没有。⇒ 用 flock 包住 ExecStart（标准做法）。
#
# ⚠️ `-n`（--nonblock）是"拿不到锁就立刻退"，而不是排队等。一个全量回填可能几十分钟，
#    让第二个进程排队等它毫无意义（另一个 10 分钟之后会再来），而且会静默堆出一串待跑进程。
# ⚠️ 认下的代价：拿不到锁时 flock 退出码是 1 ⇒ systemd 把这一轮记成 **failed**。
#    也就是说"上一轮还没跑完"在 `systemctl --failed` 里是红的。这是**有意**的：
#    它同时也是"这一轮的活儿超过了 10 分钟"的信号（回填正在追赶），而那个信号
#    平时看不到；要是改成静默跳过，名单会**越来越跟不上**而没人发现。
# ---- ★★ 锁文件为什么在 /run/mcsr-helper-track/ 里，而不是直接在 /run/ 下 ----
#
# ★ 原来那一版写的是 `/run/mcsr-helper-track.lock`，那个单元**一次都不会跑起来**：
#   `flock` 不是"打开一个已有的锁文件"，它会**创建**它（`open(O_CREAT)`）；
#   而 /run 是 systemd 挂的 tmpfs、`root:root` **0755**，部署脚本与 bootstrap
#   都不去动它的属主 ⇒ 以 `mcsr` 运行的本单元**没有权限在这层目录里建文件**。
#   症状是**最坏的那一种**：timer 每 10 分钟准点触发、部署脚本报成功、
#   `systemctl list-timers` 一片健康，而 node **一次都没跑**、库里永远没有新视频。
#   （好在它是响的，不是静的：见文件末尾那一段。但这属于"看起来绿的功能其实不动"。）
#
# ★ 修法用 systemd 自己的机制（`RuntimeDirectory=`），**不去 chmod /run**：
#   它让 systemd 在 /run 下建一个**属于本单元服务用户**的目录，单元跑完随单元一起清掉。
#   ⚠️ 被否掉的三种写法，都记在这里，免得下一个人再想一遍：
#   · `chmod 1777 /run`（或把 mcsr 加进 root 组）：为了一个锁文件松开**整台机器**的
#     运行时目录，代价与收益完全不成比例，而且下次重装/换机器就没了；
#   · 换到 `/run/lock/`：Debian 上它是 `root:root 0775`（tmpfiles.d 设的），
#     mcsr 不在 root 组里 ⇒ 照样建不出来，"换个目录"没有想象中那么简单；
#   · 在 deploy.sh 里 `install -d -o mcsr /run/mcsr-helper-track`：**能跑**，但它把一个
#     属于单元生命周期的东西放到了单元外面 —— /run 是 tmpfs，**每次重启都会被清空**，
#     于是"部署完能用、机器重启后这个功能就悄悄停了"，直到下一次部署才复活。
#     RuntimeDirectory 没有这个缺口：它是**每一次启动单元时**由 systemd 建的。
#   ⚠️ RuntimeDirectoryMode=0750：锁只给同一个用户的两个进程争，不需要别的用户能进来。
#      （tmpfs 上"谁能读得到目录"也是权限面的一部分，能小就小。）
#   ⚠️ 这也顺带说明：**deploy.sh 不需要为这件事加任何一行** —— 目录是 systemd 按
#      ExecStart 前一刻建的，deploy 那一段要做的只是"把单元装上 + daemon-reload"，
#      而那两件事它本来就在做。
RuntimeDirectory=mcsr-helper-track
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock -n /run/mcsr-helper-track/sync.lock /usr/bin/node /srv/mcsr-helper/api/track.js

# 输出默认就进 journald（不写 StandardOutput= 时它就是 journal，与 api 单元显式写的那两行等价）
# ⇒ 摘要与失败都在 `journalctl -u mcsr-helper-track` 里，而 spec §6.3 那份摘要的**全部意义**
#   就是它必须能被人看到。
#
# ---- 万一上面那条路又坏了，人看到的是什么（"响"而不是"静"）----
#
# 上面那个锁换成了 RuntimeDirectory，但同类缺陷要能被认出来，所以把**症状**写在这里。
# 权限不对时 `flock` 连锁都 open 不起来 ⇒ 它自己打一行 errno 原文
# （`flock: cannot open lock file /run/mcsr-helper-track/sync.lock: Permission denied`）
# 并以**非零**退出 ⇒ systemd 把这一轮记成 `failed`。⇒ 人会看到这三样，**全都不是静默的**：
#   · `systemctl status mcsr-helper-track.service` → `failed`，而且 journal 里每一次触发
#     都有一段，10 分钟一轮、一轮不落；
#   · `systemctl --failed` 一直挂着这个单元；
#   · `journalctl -u mcsr-helper-track` 里**完全没有** `track:` 开头的那份摘要
#     —— 那正是"node 根本没跑"的判据（跑起来了就一定会有摘要，哪怕一条视频都没同步）。
# ⚠️★ 退出码是 **66**（`EX_NOINPUT`），不是 1 —— 2026-09-16 复审对着 util-linux 的
#    `sys-utils/flock.c` 逐行核过（`open_file()` 失败 ⇒ `err(EX_NOINPUT, "cannot open lock file %s")`；
#    `errno` 是 `ENOSPC`/`EROFS` 时是 73 `EX_CANTCREAT`，`ENOMEM`/`EMFILE`/`ENFILE` 时是 71 `EX_OSERR`）。
#    所以 status 那一行长这样：`status=66/n/a`（**不是** `status=1/FAILURE`）。
#    本文件更早那一版写的是"以 1 退出"——那是**错的**（1 是**拿不到锁**时的码，见下）。
# ⚠️ 反过来读这条：`systemctl list-timers mcsr-helper-track.timer` 是**看不出来**的
#    （timer 自己一直是 active/waiting，"下一次触发时间"也照常往前滚）—— 别拿它当健康检查。
#
# ⚠️★ 但 `failed` **不止那一个成因**（2026-09-16 最终评审补的第三种，原来这里漏了它，
#    漏的后果是把运维引向错结论）：`track.js` 是**有失败就非零退出**的
#    （spec §6.3 / `track.ts:exitCodeFor`）—— 某一个博主抓不动（上游 `-412`/`-352`
#    甩不掉、链接失效、`page.count` 读不到…）就是一条**每 10 分钟都来一次**的红，
#    而功能**其实是好的**（别的博主照常同步、视频照常进库）。
#    只看 `systemctl --failed` 就会得出"这个功能根本没跑起来"的错结论。
# ⇒ **四种**成因靠 **journal 里的文本**分开，不要只看 `failed` 这个字：
#
#   | journal 里有什么 | 成因 | 该做什么 |
#   |---|---|---|
#   | `flock: cannot open lock file …` 那行 errno 原文（`status=66`） | **锁本身坏了**（权限/路径） | 看 /run/mcsr-helper-track 的属主与 RuntimeDirectory 那一段 |
#   | **有** `track:` 摘要 + `⚠️ 失败样例:` 行 | **某个博主失败**（本轮 node 确实跑了） | 摘要里逐条点名了 `creator=… error=…`；再去管理面板看那一行的 `last_error` |
#   | **有** `[track] 这一轮没能跑起来：` + 栈，或者 node 自己的报错（`Cannot find module`…）、**没有**摘要 | **node 跑了但崩了**：`runOnce` 抛了（数据库/我们自己的 bug）、`dist/track.js` 没装全、被 OOM 杀掉 | 栈本身就是线索；这一格**不会**下一轮自己好（与"上一轮还没跑完"完全不同） |
#   | journal 里除 systemd 自己那两行（`Starting…`/`Finished…`）之外**什么都没有** | **上一轮还没跑完**（`flock -n` 拿不到锁 ⇒ 退出 1，什么都不打印） | 看回填进度；全量回填时"10 分钟不够用"是**预期内**的，跑完就自愈 |
#
#   ⚠️ 判据是"**有没有那份摘要**"：`flock -n` 拿不到锁时什么都不打印
#      （要看到 errno 原文得加 `-v`）⇒ 最后一格只能靠"整段 journal 是空的"来判。
#      ⚠️ 2026-09-16 复审改正：原来这一格只写"没有摘要、也没有 errno 原文"，
#      而那**同时**被"node 崩了"那一格满足（第三行也是没有摘要的）⇒ 会把一次崩
#      诊断成"上一轮超时、下一轮就好"。**两格的分别是"有没有 node 自己的输出"。**
#   ⚠️ 第二、三行的"红"是**长期**的（那个博主/那个 bug 不会自己好），最后一格是**短期**的
#      （下一轮就好了）。都是有意为之（spec §6.3：全量失败不能看起来像空轮询），
#      别为了让 `--failed` 变绿去动退出码。
