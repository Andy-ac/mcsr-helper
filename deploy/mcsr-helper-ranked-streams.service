# deploy/mcsr-helper-ranked-streams.service
#
# 安装（deploy.sh 会做，手工装的话是这几行）：
#   sudo install -m 0644 deploy/mcsr-helper-ranked-streams.service /etc/systemd/system/
#   sudo install -m 0644 deploy/mcsr-helper-ranked-streams.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mcsr-helper-ranked-streams.timer
#
# 它做什么（一句话）：读一次 MCSR Ranked 的公开 `/live` 载荷，把里面**twitch** 的直播
# 链接收进本应用的「直播」频道（`live_channels`，标签 `ranked`）。规则与那一层为什么
# 只插不改写在 `services/api/src/ranked/ingest.ts` 的文件头。
#
# ⚠️ 两个文件名**不能改**：timer 里没有写 `Unit=`，systemd 就是按**同名**去找
#    这个 service（`mcsr-helper-ranked-streams.timer` → `.service`）。
#    改名的表现是"timer 装上了、时间到了什么都没发生"（`track.service` 同一段）。
#
# ⚠️ 这里**故意没有**加固那一套（api 单元里的 ProtectSystem / ReadWritePaths…）——
#    与 track 单元同一条：那是一次独立的安全改动，不在这一轮里。
#    要加的时候先看清下面 RuntimeDirectory 那一段：锁文件必须落在一个**本单元可写**的
#    目录里，而 /run 本身不是。

[Unit]
Description=MCSR Helper — ranked live twitch channels ingest (one shot)
After=network-online.target

[Service]
Type=oneshot
User=mcsr
# ★ 与 mcsr-helper-api.service:20 逐字对齐（track.service 同一条理由）：那个单元已经在
#   生产上用 Group=mcsr 跑着 ⇒ 这个组一定存在。写了它的作用是**明确**，而不是靠
#   "systemd 会去取这个用户的主组"那条默认行为 —— 默认值在有人把 mcsr 加进别的组、
#   或换了机器重建用户时会变，而变了以后 RuntimeDirectory 的属组跟着变，
#   表现是那个锁目录的权限与 api 单元建出来的不是一套。
Group=mcsr
WorkingDirectory=/srv/mcsr-helper/api
Environment=NODE_ENV=production
# DB_PATH 显式给出，不依赖 cwd —— 与 mcsr-helper-api.service / track.service 同一条理由：
# 否则"从别的目录启动"会静默打开另一个库文件，表现为"数据不见了"
# （⚠️ 对本单元尤其刺眼：它**不打印**自己写的库在哪，那一行摘要里也只有条数）。
Environment=DB_PATH=/srv/mcsr-helper/api/data/mcsr.db
# node:sqlite 目前会打印一行 ExperimentalWarning。功能正常，只是噪音；
# 关掉它以免掩盖真正的警告（track.service 同一行）。
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning
# ---- ★ 凭据：**故意没有** EnvironmentFile ----
#
# track.service 里有 `EnvironmentFile=-/etc/mcsr-helper/track.env`，那里面是
# YouTube / Twitch 的密钥（那个作业真的要用）。**本作业一个密钥都不需要**：
# 上游 `api.mcsrranked.com` 的 `/live` 是**公开端点**（spec §2.1 实测：浏览器直连、
# 不带任何 key/token 就取得到 —— 那正是 A 方案成立的前提）。
# ⇒ 不写它，而且这是**有意的**：`EnvironmentFile` 会把整份密钥注进**这个进程**的环境，
#   而这个进程（一次 GET + 几条 INSERT）没有任何理由看得见它们。少一处能读到密钥的
#   进程就少一个泄漏面，也让"这个作业的失败档位"少一档（**不存在**"凭据没配"这种可能，
#   所以 `track.ts` 那种"跳过并打印原因"的分支在这里也没有）。
# ⚠️ 它仍然读三个**可选**的环境变量（`MCSR_RANKED_LIVE_URL` / `_TTL_MS` / `_TIMEOUT_MS`）——
#    那三个是测试与排障的接缝，默认值就是生产要的值（公开入口、8 秒超时），
#    **不要**为了它们把 track.env 拉进来。
# ---- 防重叠（★ spec §3.4 的同一个要求，不是顺手加的）----
#
# `Type=oneshot` 的 timer **不保证**上一轮跑完才启动下一轮：到点了 systemd 就会起
# （`RandomizedDelaySec` 也一样，它只是把落点抖动一下）。而 db/index.ts 里
# `PRAGMA busy_timeout = 5000` 会让两个重叠的进程**排队等着写**而不是报错 ⇒
# 同一个频道会被两个进程各插一次（本作业那条 INSERT 是 NULL 安全的，
# 所以结果是**多一行白插**而不是重复行，但只要多写一次就有下一次），而且日志里一行错都没有。
# ⇒ 用 flock 包住 ExecStart（标准做法，与 track 单元逐字同形）。
#
# ⚠️ `-n`（--nonblock）是"拿不到锁就立刻退"，而不是排队等。本作业一轮大约一秒
#    （一次 351 ms 的 GET + 几条 INSERT，spec §2.1），所以"上一轮还没跑完"只可能是
#    **卡在上游**（超时上界 8 秒）—— 让第二个进程排队等它毫无意义。
# ⚠️ 认下的代价：拿不到锁时 flock 退出码是 1 ⇒ systemd 把这一轮记成 **failed**。
#    这是**有意**的：它同时也是"有一轮卡住了"的信号，而那个信号平时看不到
#    （改成静默跳过的话，卡住的那一轮与正常的一轮在 journal 里长得一模一样）。
# ---- ★★ 锁文件为什么在 /run/mcsr-helper-ranked-streams/ 里，而不是直接在 /run/ 下 ----
#
# ★ 这一段是 track 单元踩过的坑**逐字适用**（那里的现场：timer 每 10 分钟准点触发、
#   部署脚本报成功、`systemctl list-timers` 一片健康，而 node **一次都没跑**、
#   库里永远没有新数据）：
#   `flock` 不是"打开一个已有的锁文件"，它会**创建**它（`open(O_CREAT)`）；
#   而 /run 是 systemd 挂的 tmpfs、`root:root` **0755**，部署脚本与 bootstrap
#   都不去动它的属主 ⇒ 以 `mcsr` 运行的本单元**没有权限在这层目录里建文件**。
#
# ★ 修法用 systemd 自己的机制（`RuntimeDirectory=`），**不去 chmod /run**：
#   它让 systemd 在 /run 下建一个**属于本单元服务用户**的目录，单元跑完随单元一起清掉。
#   ⚠️ 被否掉的三种写法（track 单元里逐个写了代价）：`chmod 1777 /run`（为一个锁文件
#   松开整台机器）、换到 `/run/lock/`（Debian 上是 root:root 0775，照样建不出来）、
#   在 deploy.sh 里 `install -d -o mcsr /run/…`（**能跑**，但 /run 是 tmpfs、
#   **每次重启都会被清空** ⇒ "部署完能用、机器重启后这个功能就悄悄停了"）。
#   RuntimeDirectory 没有这个缺口：它是**每一次启动单元时**由 systemd 建的。
#   ⚠️ RuntimeDirectoryMode=0750：锁只给同一个用户的两个进程争，不需要别的用户能进来。
#   ⚠️ 顺带说明：**deploy.sh 不需要为这件事加任何一行** —— 目录是 systemd 按
#      ExecStart 前一刻建的，deploy 那一段要做的只是"把单元装上 + daemon-reload"。
RuntimeDirectory=mcsr-helper-ranked-streams
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock -n /run/mcsr-helper-ranked-streams/sync.lock /usr/bin/node /srv/mcsr-helper/api/ranked-streams.js

# 输出默认就进 journald（不写 StandardOutput= 时它就是 journal，与 api 单元显式写的那两行等价）
# ⇒ 那一行摘要与失败都在 `journalctl -u mcsr-helper-ranked-streams` 里，而它的**全部意义**
#   就是必须能被人看到。
#
# ---- 万一坏了，人看到的是什么（"响"而不是"静"）----
#
# 本作业的每一次运行**恰好打一行**（成功走 stdout、失败走 stderr，
# `ranked-streams.ts` 文件头第三节）。四种成因靠那一行的文本 + 有没有它分开：
#
#   | journal 里有什么 | 成因 | 该做什么 |
#   |---|---|---|
#   | `flock: cannot open lock file …` 那行 errno 原文（`status=66`，**不是** 1） | **锁本身坏了**（权限/路径） | 看 /run/mcsr-helper-ranked-streams 的属主与 RuntimeDirectory 那一段 |
#   | `ranked-streams: 本轮失败（unavailable …）` | 上游抖了 / 超时 / 5xx ⇒ 下一轮**自己会好** | 连着一两个小时都这样再看；心跳（`/api/ranked/status`）会同时露馅 |
#   | `ranked-streams: 本轮失败（busy）` | 上游在限**我们**的流（429）⇒ 有人在拿这个出口 IP 猛打上游 | 查有没有别的脚本在用同一台机器；本作业自己只占 0.4% |
#   | `ranked-streams: 本轮失败（bad_response）` | 上游改了形状 ⇒ **我们的适配层要改** | 改 `packages/shared/src/ranked/parse.ts`（这一档不会自愈） |
#   | `ranked-streams: 本轮失败（db）` | 写库失败（磁盘满 / 表被改坏 / 约束） | 看那一行里的错误原文；**它带"已经写进去几条"** |
#   | `[ranked-streams] 这一轮没能跑起来：` + 栈 | **我们自己的 bug**（或数据库层面） | 栈本身就是线索；这一格**不会**下一轮自己好 |
#   | journal 里除 systemd 自己那两行（`Starting…`/`Finished…`）之外**什么都没有** | **上一轮还没跑完**（`flock -n` 拿不到锁，什么都不打印） | 本作业一轮约一秒 ⇒ 正常见不到；见到了就是有一轮卡住（多半卡在上游，8 秒超时） |
#
#   ⚠️ 判据是"**有没有那一行 `ranked-streams:`**"：跑起来了就一定有（哪怕一条频道都没收）。
#   ⚠️ 与 track 不一样的一点：`failed` 在这里**几乎只有真实故障**一种含义 ——
#      track 那个作业会因为"某一个博主抓不动"每 10 分钟红一次而功能其实是好的；
#      本作业没有那种"部分成功"的形态（一条频道收不动就等于整个上游读不到）。
