# ---------------------------------------------------------------------------
# 发信密钥 —— **只存在于服务器上，不进版本库**
#
# 安装（在服务器上执行一次）：
#
#   sudo install -d -m 0755 /etc/mcsr-helper
#   sudo install -m 0600 -o root -g root /dev/null /etc/mcsr-helper/mail.env
#   sudo nano /etc/mcsr-helper/mail.env      # 填入下面这一行
#   sudo systemctl restart mcsr-helper-api
#
# 或者一条命令（把值换成真的）：
#
#   sudo bash -c 'install -d -m 0755 /etc/mcsr-helper && \
#     printf "RESEND_API_KEY=re_xxxxxxxx\n" > /etc/mcsr-helper/mail.env && \
#     chmod 600 /etc/mcsr-helper/mail.env && \
#     systemctl restart mcsr-helper-api'
#
# ---------------------------------------------------------------------------
# ⚠️ 为什么单独放一个文件，而不是写进 mcsr-helper-api.service
# ---------------------------------------------------------------------------
# 那个单元文件在版本库里，而 deploy.sh 每次部署都会把它同步到服务器。
# 把密钥写进去 = 把发信权限提交进 git 历史 —— 而且**删掉之后它还在历史里**，
# 要去掉就得重写历史。
#
# 同理：不要把这个文件复制到仓库目录下，也不要贴进聊天/issue 里。
#
# ⚠️ 权限必须是 600 且属主是 root。systemd 以 root 读这个文件，
#    再把变量交给以 mcsr 用户运行的服务进程，所以 mcsr 自己读不到它 ——
#    这是有意的：即使 API 被攻破，也拿不到这台机器上的长期密钥。
#
# ⚠️ 创建或修改这个文件之后必须 `systemctl restart mcsr-helper-api`。
#    daemon-reload 不够 —— EnvironmentFile 是进程启动时读的，
#    reload 不会重新读环境。这一点和 Caddy 的域名 drop-in 是同一个坑。
# ---------------------------------------------------------------------------

# Resend API Key。在 https://resend.com/api-keys 创建。
# 权限选 **Sending access** 就够了 —— 不需要 Full access。
# 最小权限的意义：这个 key 泄漏了，损失仅限于"能发信"，
# 而不是"能读所有邮件记录、能改域名配置、能创建新 key"。
RESEND_API_KEY=re_xxxxxxxx
