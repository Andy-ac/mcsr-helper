# ---------------------------------------------------------------------------
# MCSR Helper — Caddy 反向代理配置
#
# 部署到 /etc/caddy/Caddyfile。域名通过 systemd drop-in 注入：
#   /etc/systemd/system/caddy.service.d/mcsr-helper.conf
# ⚠️ 那个 drop-in 由 deploy.sh **每次部署都同步**（和这个文件一样）。
#    它原先只在 --bootstrap 时写，于是换域名时 Caddy 会一直监听旧域名、签旧证书，
#    而部署脚本报的是成功 —— 和 deploy.sh 注释里记的另外两个坑完全同类。
#
# Caddy 会自动申请并续期 Let's Encrypt 证书 —— 这就是选它而不是 nginx 的原因。
# 前置条件：域名 A 记录已指向服务器 IP，且 80/443 已放行。
# ---------------------------------------------------------------------------

# ===========================================================================
# 主站点 —— 规范域名
#
# MCSR_DOMAIN 是**唯一的规范来源**：会话 cookie、CSP 里的 'self'、
# 邮件正文里的链接、Electron 加载的地址，全都跟着它走。
# 下面两个跳转块都是为了让它保持唯一 —— 同一个站点从不以多个域名对外，
# 否则用户会在 A 域名登录、在 B 域名发现自己"掉线了"（cookie 是按 host 存的）。
# ===========================================================================
{$MCSR_DOMAIN} {
	encode zstd gzip

	# =========================================================================
	# 响应头
	# =========================================================================
	header {
		# ⚠️⚠️ 绝对不要改成 no-referrer 或 same-origin。
		#
		# YouTube 的 Required Minimum Functionality 要求嵌入播放器的客户端
		# "必须通过 HTTP Referer 请求头标识自己"；Referer 缺失会让嵌入播放器
		# 直接报 "Error 153: Video player configuration error"。
		# strict-origin-when-cross-origin 是 YouTube 官方推荐值。
		Referrer-Policy "strict-origin-when-cross-origin"

		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"

		# 我们自己不需要摄像头/麦克风/定位，全关掉
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

		# 内容安全策略。
		#
		# frame-src 里**必须包含 'self'**。
		# ⚠️ 踩过的坑：frame-src 一旦出现，它就**完全覆盖** default-src 对 iframe 的约束 ——
		#    只写三个视频平台域名的话，**本站自己的页面反而不能被 iframe 加载**。
		#    症状极其隐蔽：iframe 被静默拦掉，浏览器不会请求那个地址（访问日志里查无此人），
		#    但 iframe 的 load 事件照常触发，父页面拿到一个空文档 ——
		#    于是"自检探针"读到了空值，报出"浏览器没有发送 Referer"的假警报，
		#    而实际上 YouTube 播得好好的。
		#
		# frame-ancestors 用 'self' 而不是 'none'。
		# ⚠️ 踩过的坑：'none' 的含义是"**任何页面**都不许嵌我，**包括同源**"。
		#    而这个 header 块是全局的，/api/* 的响应也会带上它 ——
		#    于是自检页无法 iframe 自己的探针端点，表现为"探针超时"。
		#    更隐蔽的是：frame-ancestors 会**覆盖** X-Frame-Options，
		#    所以下面那行 SAMEORIGIN 看起来允许，实际照样被拦。
		#
		# 'self' 仍然阻止**其他站点**嵌套本站（点击劫持防护的核心目的），只是允许自己嵌自己。
		#
		# 新增视频平台时必须同步改这里的 frame-src（以及 packages/shared/src/constants.ts 的 VIDEO_PLATFORMS）。
		#
		# ⚠️⚠️ 2026-09-13 补了 www.bilibili.com —— **这一条踩过一次，记在这里**。
		#    B站 的**直播**嵌入走的是官方的「活动播放器」：
		#        https://www.bilibili.com/blackboard/live/live-activity-player.html?cid=<房间号>
		#    它和我们一直用的 `player.bilibili.com`（视频嵌入）**不是同一个 host**。
		#    于是：代码改对了、**地址也拼对了**，但 iframe 被这条 CSP **静默拦掉** ——
		#    播放器那一块点开之后什么都不发生，而浏览器控制台之外没有任何提示。
		#    ⇒ 症状是"我明明修好了嵌入，点开还是不能播"。
		#    ★ 判据：**加了任何新的嵌入 host，都必须同时改这一行**，
		#      并且**在真实浏览器里点一次**验证（只测那个站点自己的响应头是不够的 ——
		#      它的响应头没有 frame 限制，不代表**我们这边**允许嵌它）。
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.mcsrranked.com https://mcsrranked.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.twitch.tv https://player.bilibili.com https://www.bilibili.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

		-Server
	}

	# =========================================================================
	# API —— 反向代理到本机的 Node 进程（只监听 127.0.0.1:3001）
	# =========================================================================
	handle /api/* {
		reverse_proxy 127.0.0.1:3001 {
			header_up X-Real-IP {remote_host}
			# ⚠️ 这里**不**设置 Cache-Control。
			# 之前写的是 `header_down Cache-Control "no-store"` —— 看起来安全，实则有害：
			# 它会把 API 自己想设的缓存策略全部覆盖掉，于是"公开读接口可以激进缓存"
			# 这条优化根本没法实现。
			# 现在由 API 为**每个响应**显式声明策略（见 services/api/src/index.ts 的中间件），
			# 那才是知道"这个端点的内容能不能缓存"的地方。
		}
	}

	# =========================================================================
	# 安装包与自动更新源
	#
	# 现在由**本机**提供（/srv/mcsr-helper/releases/）。
	# 计划里原本写的是 Cloudflare R2，理由是大陆用户下载 ~100MB 走境外 VPS
	# 会被跨境链路拖累。但 R2 需要先开桶，而 M3 的验收标准
	# （发新版本 → 应用内提示 → 更新成功）用任何静态托管都能验，
	# 所以先用本机把链路跑通，面向真实用户之前再换。
	#
	# 换成 R2 时：把下面这段换成 redir 到 R2，
	# 并同步改 apps/desktop/electron-builder.yml 的 publish.url。
	#
	# ⚠️ handle 而不是 handle_path：electron-updater 请求的是
	#    /installer/latest.yml 这个**完整路径**，而 root 指向 releases/ 之后
	#    它要找的是 releases/installer/latest.yml —— 对不上。
	#    所以这里显式用 uri strip_prefix 把 /installer 前缀去掉。
	# =========================================================================
	handle /installer/* {
		uri strip_prefix /installer
		root * /srv/mcsr-helper/releases
		file_server

		# ⚠️ latest.yml**绝不能**被缓存。
		#    它是自动更新的"有没有新版本"的唯一依据；一旦被 CDN 或浏览器缓存住，
		#    用户会一直看到"已是最新版本"，而我们完全不知道 ——
		#    这类静默失效在更新系统里是最难查的一种。
		#    安装包本身相反：文件名带版本号，可以长期缓存。
		# ⚠️ 用 `*latest.yml` 而不是 `/latest.yml`。
		#
		# 上面那句 `uri strip_prefix /installer` 会改写 URI，但 **path 匹配器
		# 比对的是改写前的原始 URI** —— 于是 `/latest.yml` 匹配不上
		# `/installer/latest.yml`，这条规则静默失效（实测：安装包拿到了
		# immutable，而 latest.yml 一个 Cache-Control 都没有）。
		#
		# 通配符形式不带前导斜杠，按后缀匹配，改写前后都成立。
		# 这类"规则写了但没生效"的错误不会报任何错，只能靠看响应头发现。
		@manifest path *latest.yml
		header @manifest Cache-Control "no-cache"
		@pkgs path *.exe *.nsis.7z *.blockmap
		header @pkgs Cache-Control "public, max-age=31536000, immutable"
	}

	# =========================================================================
	# 静态前端 —— SPA 回退到 index.html
	# =========================================================================
	handle {
		root * /srv/mcsr-helper/web
		try_files {path} /index.html
		file_server

		# 带 hash 的构建产物可以长期缓存
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# 自托管的资源图标（/icons/*.png）。
		#
		# 用一天，**不用** immutable：这些文件名不带 hash（就是 mcsrranked.png 这种），
		# 换一张图文件名不变，immutable 会让用户一年都看到旧图 —— 正是下面
		# 那段注释里描述过的同类问题。
		# 一天足够让一次浏览里的重复请求走缓存，又不至于换了图标第二天还看不到。
		# 真要立刻失效，改文件名即可（imageUrl 跟着改）。
		@icons path /icons/*
		header @icons Cache-Control "public, max-age=86400"

		# ⚠️ 其余**一律**不缓存。
		#
		# 这里踩过一次坑：最初写的是 `path / /index.html`，看起来覆盖了首页就够了，
		# 但 SPA 的任意路由（/embed-test 之类）和 .html 文件**都不匹配**，
		# 于是它们没有任何 Cache-Control，浏览器会启用启发式缓存。
		#
		# 后果很隐蔽：用户一直拿到旧 HTML，而旧 HTML 引用的是带 hash 的旧资源名，
		# 那个文件已经被新部署删掉了 —— 于是表现为"我明明改了，页面上还是旧的"，
		# 或者一个已经修好的页面看起来仍然是坏的。
		#
		# 所以规则改成白名单反选：**只有带 hash 的 /assets/* 可缓存，其他全部 no-cache**。
		#
		# ⚠️ 例外必须在这里排除，而不是靠上面那句 header 在前生效 ——
		#    Caddy 会把**所有**匹配到的 header 指令都写进响应，后面的覆盖前面的，
		#    所以 `not path /assets/*` 会把 /icons/* 也一起标成 no-cache。
		@nocache not path /assets/* /icons/*
		header @nocache Cache-Control "no-cache"
	}

	log {
		output file /var/log/caddy/mcsr-helper.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# ===========================================================================
# 跳转：www → 规范域名
#
# 为什么必须跳转，而不是"两个都直接服务"：
# 会话 cookie 是**按 host 存的**（我们没有设 Domain 属性，所以是 host-only）。
# 如果 www 和裸域各自服务一份站点，用户在 www 登录、点一个裸域链接，
# 就会发现自己"掉线了" —— 这是最难排查的那类 bug，因为两边看起来都完全正常。
# ===========================================================================
www.{$MCSR_DOMAIN} {
	redir https://{$MCSR_DOMAIN}{uri} permanent
}

# ===========================================================================
# 跳转：旧域名 → 规范域名
#
# legacy.example.invalid 是把站点搬到自有域名之前用的地址。
# 保留跳转而不是直接停掉，有两个原因：
#   · 已经发出去的链接（聊天记录、书签、别人转发的地址）不会变成死链
#   · 那个域名在 Spamhaus DBL 上被列名过（phishing 127.0.1.4 + botnet C&C 127.0.1.6）。
#     让残留引用干净地转到新域名，比让它继续对着一台配置已变的服务器要好。
#
# ⚠️ `{$MCSR_LEGACY_DOMAIN:默认值}` 是 Caddy 的"带默认值的环境变量"语法。
#    给默认值是必须的，不是保险起见：变量为空时这一行会退化成孤立的 `{`，
#    Caddy 会把它当成全局选项块解析，然后报出完全误导性的
#    "unrecognized global option: redir"（这个坑我们在 MCSR_DOMAIN 上踩过一次）。
# ===========================================================================
{$MCSR_LEGACY_DOMAIN:legacy.example.invalid} {
	redir https://{$MCSR_DOMAIN}{uri} permanent
}
