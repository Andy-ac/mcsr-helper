# ---------------------------------------------------------------------------
# MCSR Helper — Caddy 反向代理配置
#
# 部署到 /etc/caddy/Caddyfile，并把 MCSR_DOMAIN / R2_PUBLIC_HOST 通过
# systemd 的 EnvironmentFile 注入（见 deploy/mcsr-helper-caddy.env.example）。
#
# Caddy 会自动申请并续期 Let's Encrypt 证书 —— 这就是选它而不是 nginx 的原因。
# 前置条件：域名 A 记录已指向服务器 IP，且 80/443 已放行。
# ---------------------------------------------------------------------------

{$MCSR_DOMAIN} {
	encode zstd gzip

	# =========================================================================
	# 响应头
	# =========================================================================
	header {
		# ⚠️⚠️ 绝对不要改成 no-referrer 或 same-origin。
		#
		# YouTube 的 Required Minimum Functionality 要求嵌入播放器的客户端
		# "必须通过 HTTP Referer 请求头标识自己"；Referer 缺失会让嵌入播放器
		# 直接报 "Error 153: Video player configuration error"。
		# strict-origin-when-cross-origin 是 YouTube 官方推荐值。
		Referrer-Policy "strict-origin-when-cross-origin"

		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"

		# 我们自己不需要摄像头/麦克风/定位，全关掉
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

		# 内容安全策略。
		#
		# frame-src 里**必须包含 'self'**。
		# ⚠️ 踩过的坑：frame-src 一旦出现，它就**完全覆盖** default-src 对 iframe 的约束 ——
		#    只写三个视频平台域名的话，**本站自己的页面反而不能被 iframe 加载**。
		#    症状极其隐蔽：iframe 被静默拦掉，浏览器不会请求那个地址（访问日志里查无此人），
		#    但 iframe 的 load 事件照常触发，父页面拿到一个空文档 ——
		#    于是"自检探针"读到了空值，报出"浏览器没有发送 Referer"的假警报，
		#    而实际上 YouTube 播得好好的。
		#
		# 新增视频平台时必须同步改这里（以及 packages/shared/src/constants.ts 的 VIDEO_PLATFORMS）。
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.twitch.tv https://player.bilibili.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		-Server
	}

	# =========================================================================
	# API —— 反向代理到本机的 Node 进程（只监听 127.0.0.1:3001）
	# =========================================================================
	handle /api/* {
		reverse_proxy 127.0.0.1:3001 {
			header_up X-Real-IP {remote_host}
			# API 响应不做缓存
			header_down Cache-Control "no-store"
		}
	}

	# =========================================================================
	# 安装包与自动更新源 —— 重定向到 Cloudflare R2。
	#
	# 为什么不用本机分发：大陆用户下载 ~100MB 的 Electron 安装包，
	# 走境外 VPS 会被跨境链路拖累（实测其他跨境线路每天有 5–12 小时劣化窗口）。
	# R2 的免费额度足够支撑到几千用户。
	#
	# M3 之前 R2 桶还不存在，这个块可以先注释掉。
	# =========================================================================
	# handle /installer/* {
	# 	redir https://{$R2_PUBLIC_HOST}/mcsr-helper/releases{uri} permanent
	# }

	# =========================================================================
	# 静态前端 —— SPA 回退到 index.html
	# =========================================================================
	handle {
		root * /srv/mcsr-helper/web
		try_files {path} /index.html
		file_server

		# 带 hash 的构建产物可以长期缓存
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# ⚠️ 其余**一律**不缓存。
		#
		# 这里踩过一次坑：最初写的是 `path / /index.html`，看起来覆盖了首页就够了，
		# 但 SPA 的任意路由（/embed-test 之类）和 .html 文件**都不匹配**，
		# 于是它们没有任何 Cache-Control，浏览器会启用启发式缓存。
		#
		# 后果很隐蔽：用户一直拿到旧 HTML，而旧 HTML 引用的是带 hash 的旧资源名，
		# 那个文件已经被新部署删掉了 —— 于是表现为"我明明改了，页面上还是旧的"，
		# 或者一个已经修好的页面看起来仍然是坏的。
		#
		# 所以规则改成白名单反选：**只有带 hash 的 /assets/* 可缓存，其他全部 no-cache**。
		@nocache not path /assets/*
		header @nocache Cache-Control "no-cache"
	}

	log {
		output file /var/log/caddy/mcsr-helper.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
