# ---------------------------------------------------------------------------
# 部署配置模板
#
#   1. cp deploy/deploy.env.example deploy/deploy.env
#   2. 填好下面的值（deploy.env 已在 .gitignore 里，不会被提交）
#   3. bash deploy/deploy.sh
# ---------------------------------------------------------------------------

# 服务器 SSH 目标（和你 ~/.ssh/config 里的别名一致也可以，例如 mcsr-hk）
MCSR_SSH_HOST=root@1.2.3.4
MCSR_SSH_PORT=22

# SSH 私钥路径。留空 = 用密码或默认密钥。
# 强烈建议用密钥而不是密码：deploy.sh 是自动化脚本，密码登录会卡在交互提示上。
# 生成：ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_mcsr -N ""
# 安装：ssh-copy-id -i ~/.ssh/id_ed25519_mcsr.pub root@你的服务器
MCSR_SSH_KEY=~/.ssh/id_ed25519_mcsr

# ---------------------------------------------------------------------------
# 规范域名。必须与 packages/shared/src/constants.ts 里的 SITE.productionOrigin
# 一致 —— 它是唯一的来源：会话 cookie、CSP 的 'self'、邮件正文里的链接、
# Electron 加载的地址全都跟着它走。
#
# ⚠️ 前置条件：先在域名后台把这个域名的 A 记录指向你的 VPS IP。
#
# ⚠️ 它必须是**唯一**对外的域名。www 和 MCSR_LEGACY_DOMAIN 都会 301 跳到这里 ——
#    会话 cookie 是按 host 存的，同一个站点以两个域名服务会让用户在
#    一个域名登录、在另一个域名发现自己"掉线了"。
# ---------------------------------------------------------------------------
MCSR_DOMAIN=mcsrhelper.com

# 旧域名，只用于 301 跳转到规范域名。留空时 Caddyfile 里有一份同样的默认值。
# 保留它的意义：已经发出去的链接不会变成死链。
MCSR_LEGACY_DOMAIN=legacy.example.invalid

# 服务器上的目录布局
MCSR_WEB_DIR=/srv/mcsr-helper/web
MCSR_API_DIR=/srv/mcsr-helper/api
MCSR_API_SERVICE=mcsr-helper-api

# 首次部署时设为 1：会先跑一遍服务器初始化（装 Node / Caddy / 建目录 / 装 systemd 单元）
# 之后的日常部署保持 0。
MCSR_BOOTSTRAP=0

# 部署完成后用于自检。留空则跳过自检。
#
# ⚠️ 自检会用 --resolve 把域名硬解析到服务器 IP，绕开两件事：
#    本机 DNS 可能被污染；服务器是 NAT 后的内网地址、不支持 hairpin。
MCSR_HEALTHCHECK_URL=https://mcsrhelper.com/api/health
