# ---------------------------------------------------------------------------
# 根目录的环境变量模板 —— **这是一个索引，不是一个能直接用的配置**
#
#   cp .env.example .env      ← ⚠️ 别急着这么做：先读下面那段
#
# 为什么根目录的这份**不填任何值**：本仓的环境变量分三类，而它们**各自的
# 安装位置不一样**，都塞进一个 .env 里是错的（其中两类放错地方就再也不生效）：
#
#   ① 部署机的配置   → deploy/deploy.env            （本机文件，gitignored）
#   ② 服务器上的密钥 → /etc/mcsr-helper/*.env       （服务器上的 0600 root 文件）
#   ③ 本地开发用的   → 根目录 .env / apps/web 的环境变量
#
# ⚠️ ② 类**绝不能**放进仓库里，也**绝不能**写进 systemd 单元文件：
#    单元文件在版本库里，而 deploy.sh 每次部署都会把它同步到服务器 ——
#    把密钥写进去 = 提交进 git 历史，删掉之后它还在历史里。
#    单元里对应的做法是 `EnvironmentFile=-/etc/mcsr-helper/<name>.env`
#    （前缀的 `-` 表示"文件不存在也照常启动"）。
#
# ⚠️ ③ 类里唯一需要小心的：根目录的 `.env` 会**被所有 workspace 包读到**
#    （Vite 按根目录读）。所以本仓把开发用的变量收在 `.env.local`
#    （`.gitignore` 里 `.env` / `.env.local` / `.env.*` 都已忽略；
#      `.env.example` 这条模板是**唯一**被显式放行的，见 .gitignore 的说明）。
#
# ---------------------------------------------------------------------------
# 一份就能跑起来的最小配置（自建者按顺序做）
# ---------------------------------------------------------------------------
# 1) 什么都没配也**能**跑：`pnpm dev:web` 起来就是一个可用的站点骨架，
#    邮件走 console 驱动（不真发信）、视频追踪跳过并打印原因。
# 2) 要部署到服务器：deploy/deploy.env.example（域名 + SSH；见 deploy/README.md）
# 3) 要真发验证邮件：deploy/mail.env.example → 服务器 /etc/mcsr-helper/mail.env
# 4) 要让视频追踪抓 YouTube / Twitch：deploy/track.env.example → 同目录 track.env
# 5) 要用排位赛种子查询：deploy/seeds.env.example → 同目录 seeds.env
#    ⚠️ 种子上游地址**没有默认值**：不配 = 这条功能整体 503 seed_not_configured
#    （上游是第三方的机器，写死一个地址等于让每个照抄本仓的人都打到别人的服务器上）
# ===========================================================================
# 下面逐个列出**名字**（值一律留空 —— 这里不提供、也不该提供任何真实值）
# ===========================================================================

# ---- ③ 本地开发（根目录 .env / .env.local）--------------------------------

# API 的监听地址与端口（默认 127.0.0.1:3001；vite 的开发代理指向它）
#   HOST=
#   PORT=

# Vite 开发代理的目标（apps/web/vite.config.ts 读它，默认 http://127.0.0.1:3001）
#   API_TARGET=

# Electron 壳在开发时加载哪个地址（不设则由 desktop 的 build.mjs 决定）
#   VITE_DEV_SERVER_URL=

# ---- ② 服务器上的密钥与配置（/etc/mcsr-helper/*.env）----------------------

# 发信（Resend）。见 deploy/mail.env.example
#   RESEND_API_KEY=

# 视频追踪的凭据（bilibili 不需要任何凭据）。见 deploy/track.env.example
#   MCSR_YOUTUBE_KEY=
#   MCSR_TWITCH_ID=
#   MCSR_TWITCH_SECRET=

# 排位赛种子上游。见 deploy/seeds.env.example
#   MCSR_SEED_API_BASE=            # 必填，否则整组端点 503 seed_not_configured
#   MCSR_SEED_WRITE_ENABLED=       # 补录（写接口）默认关闭，要开显式设 1
#   MCSR_SEED_TIMEOUT_MS=          # 默认 15000

# ---- 单元文件里已经给好的（一般不用改，列出来是为了"不全靠猜"）---------
# 见 deploy/mcsr-helper-api.service 的 [Service] 段，那里每一条都写了理由：
#   NODE_ENV=production
#   HOST=127.0.0.1                 # API 绝不能被公网直连，对外只经 Caddy
#   PORT=3001
#   DB_PATH=/srv/mcsr-helper/api/data/mcsr.db
#   UPLOAD_DIR=/srv/mcsr-helper/api/data/uploads
#   NODE_OPTIONS=--disable-warning=ExperimentalWarning
#   MCSR_PUBLIC_ORIGIN=            # 站点对外 origin，必须与 SITE.productionOrigin 一致
#   MCSR_MAIL_DRIVER=resend        # 测试/本地用 console
#   MCSR_MAIL_FROM= / MCSR_MAIL_FROM_NAME=
#   MCSR_MAIL_DIR=                 # 只在 console 驱动下用：把 .eml 落到这个目录
#   MCSR_RELEASES_DIR=             # 桌面安装包目录（/api/desktop/release 读它）
#   MCSR_CONTENT_DIR=              # 内容文件目录（GET /api/file-catalog 读它下面的
#                                  #   file-catalog.json）。默认 /srv/mcsr-helper/content，
#                                  #   只在本地开发/测试时指到别处

# ---- 代码里带默认值、只在排查时才动的（同样只列名字）---------------------
# 留这些"接缝"的理由写在各自的代码注释里（每一条都写了默认值和为什么）：
#   MCSR_RANKED_STATUS_URL= / MCSR_RANKED_STATUS_TTL_MS= / MCSR_RANKED_STATUS_TIMEOUT_MS=
#   MCSR_RANKED_LIVE_URL=   / MCSR_RANKED_LIVE_TTL_MS=   / MCSR_RANKED_LIVE_TIMEOUT_MS=

# ---- 部署机（deploy/deploy.env，见 deploy/deploy.env.example）------------
#   MCSR_SSH_HOST= / MCSR_SSH_PORT= / MCSR_SSH_KEY=
#   MCSR_DOMAIN=                   # 唯一对外的域名
#   MCSR_LEGACY_DOMAIN=            # 可选：旧域名 301，**默认空 = 不做跳转**
#   MCSR_WEB_DIR= / MCSR_API_DIR= / MCSR_API_SERVICE=
#   MCSR_BOOTSTRAP= / MCSR_HEALTHCHECK_URL=
